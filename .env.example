# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
# Authorized redirect URI must be: <your deployed URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only Google accounts on this domain may sign in. Leave empty to allow any
# Google account (not recommended for a firm-internal tool).
ALLOWED_EMAIL_DOMAIN=calalaw.com

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The full URL this app is served at (no trailing slash), e.g. https://firmlynotes.com
NEXTAUTH_URL=http://localhost:3000

# --- Anthropic (note parsing) ---
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5
