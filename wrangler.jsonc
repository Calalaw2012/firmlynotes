{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Also the Worker's name in the Cloudflare dashboard (Workers & Pages).
  "name": "firmly-notes",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  // Required by the OpenNext adapter — Next.js's Node.js runtime (used for
  // the API routes and NextAuth in this app) needs Node APIs Workers don't
  // enable by default.
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_modules"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Non-secret values only — see the README's "Deploy to Cloudflare"
  // section for why GOOGLE_CLIENT_SECRET, NEXTAUTH_SECRET, and
  // ANTHROPIC_API_KEY are set as `wrangler secret put` instead of here.
  "vars": {
    "ALLOWED_EMAIL_DOMAIN": "calalaw.com",
    "ANTHROPIC_MODEL": "claude-sonnet-5"
  },
  "observability": {
    "enabled": true
  },
  // KV namespace used to remember attendee name -> email address choices a
  // user has confirmed, so the same name auto-resolves next time instead of
  // asking again. Scoped per signed-in user inside lib/attendeeAliases.ts.
  "kv_namespaces": [
    { "binding": "ATTENDEE_ALIASES", "id": "2b6aa88ed91446fca30a13be5600c376" }
  ]
}
